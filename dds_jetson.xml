<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for every shell in the Jetson container.
  Applied via FASTRTPS_DEFAULT_PROFILES_FILE (set by dds_env.sh).

  Fixes two problems that cause "topics list, echo/RViz empty":
  1. docker0 collision (172.17.0.1 on both machines) — fixed by interfaceWhiteList
     restricting the transport to the Jetson uplink IP + loopback; docker0 never
     announced.
  2. Campus WiFi blocks DDS multicast — fixed by unicast initialPeersList.
     Local nodes discover each other via 127.0.0.1; the PC is not listed here
     (it lists the Jetson IP in its own profile and initiates discovery).

  SHM transport removed: FastDDS 2.6.x SHM in Docker completes discovery but
  RELIABLE and BEST_EFFORT data delivery both silently fail.

  maxInitialPeersRange on the transport raises the default (2) to 32 so all
  local participant IDs are probed when scanning the loopback initial peer.
  It belongs on the transport descriptor, not in the participant block.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>wifi_and_lo</transport_id>
        <type>UDPv4</type>
        <!-- __JETSON_IP__ is substituted at runtime by dds_env.sh (active uplink IP).
             This avoids interface-name lookup issues in FastDDS 2.6.x where
             interfaceWhiteList entries must be IP addresses, not names. -->
        <interfaceWhiteList>
          <address>__JETSON_IP__</address>
          <address>127.0.0.1</address>
        </interfaceWhiteList>
        <maxInitialPeersRange>32</maxInitialPeersRange>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="default_participant" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>wifi_and_lo</transport_id>
        </userTransports>
        <builtin>
          <!-- initialPeersList is a direct child of <builtin>, NOT of
               <discovery_config> — the latter is discoverySettingsType and
               does not accept this element (causes an XMLPARSER Error). -->
          <initialPeersList>
            <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
