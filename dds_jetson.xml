<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for every shell in the Jetson container.
  Applied automatically via FASTRTPS_DEFAULT_PROFILES_FILE (set by dds_env.sh,
  sourced by /etc/profile.d/eyerobot_ros.sh in every container shell).

  Fixes two problems that together cause "topics list, echo/RViz empty":

  1. docker0 IP collision — both Jetson and PC have docker0 at 172.17.0.1.
     Default DDS announces all interfaces, so each side routes data to its own
     docker0 bridge and the packets vanish.  Fixed by interfaceWhiteList
     restricting to wlan0 + loopback only — docker0 never appears as a locator.

  2. Campus WiFi blocks DDS multicast — fixed by unicast initialPeersList.
     Local nodes use 127.0.0.1; the PC is NOT listed here (it lists the Jetson
     IP in its own profile, generated by dds_setup.sh, and initiates discovery).

  What was removed and why:
  - SHM transport: FastDDS 2.6.x SHM in Docker completes discovery ("matched")
    but RELIABLE and BEST_EFFORT data delivery both silently fail.  Removed.
  - Hardcoded PC IP (128.179.186.23): the PC initiates cross-machine discovery
    by listing the Jetson IP in its own profile, so the Jetson does not need to
    know the PC IP.  This makes the Jetson profile static (no SSH push needed).
  - Hardcoded Jetson IP (128.179.186.106): replaced by interface name "wlan0" so
    the profile survives DHCP changes.

  max_initial_peers_range raises the default (2) so all local nodes are found:
  with the default of 2, participant IDs 3+ on loopback were never discovered.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>wifi_and_lo</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <!-- wlan0 = Jetson Nano built-in WiFi; excludes docker0 (172.17.0.1).
               Interface NAME survives DHCP IP changes.
               If topics still don't appear, verify with `ip link show` on the
               Jetson and update this address to match the actual WiFi iface. -->
          <address>wlan0</address>
          <address>127.0.0.1</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="default_participant" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>wifi_and_lo</transport_id>
        </userTransports>
        <builtin>
          <discovery_config>
            <initialPeersList>
              <!-- Scan loopback for all local nodes. -->
              <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
            </initialPeersList>
            <!-- Probe participant IDs 0..31 on each initial peer address.
                 Default is 2, which misses nodes beyond the second participant. -->
            <max_initial_peers_range>32</max_initial_peers_range>
          </discovery_config>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
