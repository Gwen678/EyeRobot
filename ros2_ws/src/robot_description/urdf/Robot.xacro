<?xml version="1.0" ?>
<robot name="Robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find robot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find robot_description)/urdf/Robot.trans" />
<xacro:include filename="$(find robot_description)/urdf/Robot.gazebo" />

<!-- REP-103/105 driving frame: X forward, +Y left, Z up. The estimator publishes
     odom->base_link, so this frame must stay axis-aligned. The chassis mesh is
     mounted under it via a fixed joint that applies the +90 deg roll about X
     needed to stand the mesh upright, WITHOUT tilting the odometry frame.
     Flip the sign of the roll if it rotates the wrong way. Root link is empty
     (no inertia) so KDL emits no warning.

     The xyz translation places base_link at the DRIVE-WHEEL AXLE MIDPOINT (the
     differential-drive kinematic center the estimator integrates), not the CAD
     origin. It is -1 * (axle midpoint expressed in base_link); with it the two
     wheels sit symmetric at Y = +/-0.146 m, X~=0, Z~=0. Recompute if the wheel
     joint origins change: take the mean of the two Revolution joint origins
     (chassis frame), map (x,y,z)->(x,-z,y), and negate. -->
<link name="base_link"/>

<joint name="base_mount" type="fixed">
  <origin xyz="0.018885 -0.125267 -0.034371" rpy="1.5708 0 0"/>
  <parent link="base_link"/>
  <child link="chassis"/>
</joint>

<link name="chassis">
  <!-- Visual/collision only; inertia not needed for visualization. -->
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://robot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://robot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="Moteur_+_Roue_v1_Symetrie_miroir__1">
  <inertial>
    <origin xyz="5.182027081260254e-07 3.7287997872448297e-06 -0.021890971794159053" rpy="0 0 0"/>
    <mass value="4.893607945468814"/>
    <inertia ixx="0.005485" iyy="0.005484" izz="0.008133" ixy="0.0" iyz="1e-06" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.018502 -0.032756 0.27162" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://robot_description/meshes/Moteur_+_Roue_v1_Symétrie_miroir__1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.018502 -0.032756 0.27162" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://robot_description/meshes/Moteur_+_Roue_v1_Symétrie_miroir__1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="Moteur_+_Roue_v3_1">
  <inertial>
    <origin xyz="-9.7522353499635e-07 3.924730006502064e-06 0.02189068703142081" rpy="0 0 0"/>
    <mass value="4.893487253767867"/>
    <inertia ixx="0.005485" iyy="0.005483" izz="0.008133" ixy="0.0" iyz="-1e-06" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.019268 -0.035986 -0.021086" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://robot_description/meshes/Moteur_+_Roue_v3_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.019268 -0.035986 -0.021086" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://robot_description/meshes/Moteur_+_Roue_v3_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="left_wheel_joint" type="continuous">
  <origin xyz="-0.018502 0.032756 -0.27162" rpy="0 0 0"/>
  <parent link="chassis"/>
  <child link="Moteur_+_Roue_v1_Symetrie_miroir__1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
  <origin xyz="-0.019268 0.035986 0.021086" rpy="0 0 0"/>
  <parent link="chassis"/>
  <child link="Moteur_+_Roue_v3_1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<!-- ros2_control block: hardware interface plugin + joint interfaces.
     Parameters mirror state_estimator_node.py and cmd_vel_bridge_node.py. -->
<ros2_control name="eyerobot_hardware" type="system">
  <hardware>
    <plugin>eyerobot_hardware/EyeRobotHardware</plugin>
    <param name="counts_per_output_rev">5756.0</param>
    <param name="right_feedback_sign">1.0</param>
    <!-- +1 since firmware invert_encoder=true on the left wheel (AppBus.hpp):
         published left ticks now read positive on forward. MUST match the
         flashed firmware — with old firmware use -1.0. -->
    <param name="left_feedback_sign">1.0</param>
    <param name="right_fb_topic">motor_rwheel_fb</param>
    <param name="left_fb_topic">motor_lwheel_fb</param>
    <param name="right_cmd_topic">motor_rwheel_cmd</param>
    <param name="left_cmd_topic">motor_lwheel_cmd</param>
  </hardware>
  <joint name="right_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="left_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

<!-- IMU (OAK-D) mount, relative to base_link (the axle center). Offsets are from
     CAD, measured from the wheel-axle midpoint: 0.42 m forward (X), 0.135 m up (Z),
     centered on width (Y = 0). Translation is placement only — it does NOT affect
     orientation fusion (we fuse roll/pitch/yaw-rate, not linear accel). The camera
     is mounted level (no tilt), so rpy = 0: its REP-103-remapped axes align with
     base_link and a level robot reports ~0 roll/pitch (in complementary mode). -->
<link name="imu_link"/>
<joint name="imu_mount" type="fixed">
  <origin xyz="0.42 0 0.135" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="imu_link"/>
</joint>

<!-- IMU data is published in imu_link directly: imu_remap_node corrects the
     BMI270's 180°-about-X mounting in the DATA (gyro/accel signs) and stamps
     frame_id imu_link. A TF-level fix (oak_imu_frame rolled by pi) was tried
     and abandoned — robot_localization did not flip the integrated yaw rate
     despite the transform being live (hardware-verified 2026-06-10). -->

<!-- RPLidar A1M8 — centered on robot (x=0, y=0), mounted at the top.
     Z=0.20 m is measured from the wheel-axle midpoint (base_link origin).
     ADJUST Z if the actual mount height differs — measure from axle to lidar
     scan plane in metres. The lidar sits flat (no roll/pitch), facing forward
     (no yaw offset). Frame name "laser" matches rplidar_ros's default frame_id
     so no remapping is needed. -->
<link name="laser"/>
<joint name="lidar_mount" type="fixed">
  <origin xyz="0.280 -0.040 0.211" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="laser"/>
</joint>

</robot>
