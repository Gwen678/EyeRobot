<?xml version="1.0"?>
<package format="3">
  <name>oak_imu</name>
  <version>0.1.0</version>
  <description>OAK-D Lite IMU publisher + RViz cube (raw, bias-corrected gyro orientation)</description>
  <maintainer email="pcondesalvarelli@gmail.com">Pedro</maintainer>
  <license>MIT</license>

  <!-- The DepthAI python driver (depthai==2.x) is a pip dependency, not a
       rosdep key; install it with: pip install -r requirements.txt -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
