<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomous_controller</name>
  <version>0.1.0</version>
  <description>Mission behavior tree: flow-through Nav2 waypoint routes with pullback recovery.</description>
  <maintainer email="pcondesalvarelli@gmail.com">Pedro Conde</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>py_trees</depend>
  <depend>py_trees_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros_py</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
