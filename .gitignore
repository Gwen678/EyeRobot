# ─────────────────────────────────────────────────────────────────────────────
# EyeRobot .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── ROS 2 / colcon build artifacts ──────────────────────────────────────────
build/
install/
log/
**/COLCON_IGNORE
**/.colcon_install_layout

# ── ESP32 / PlatformIO firmware build ────────────────────────────────────────
firmware/.pio/
.pio/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# Virtual environments
yolo_env/
.venv/
venv/
env/

# ── ML training: datasets, runs, stock weights (regenerable / huge) ──────────
# Trained product models the app needs (perception/best.pt, best.blob) stay
# tracked via the negations below.
runs/
datasets/
dataset/
lego_dataset/
ml/work/
*.onnx
*.engine
yolov8n.pt
yolov8*.pt
!perception/best.pt
!perception/best.blob
!**/perception/best.pt
!**/perception/best.blob

# ── Large NVIDIA CUDA libs (if a venv ever leaks in) ─────────────────────────
*libcublasLt.so.13*
*libcudnn.so.9*
*libcusparse.so.12*
*libnvrtc.so.13*

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store

# ── Local-only docs mirror (nav2/ros2 doc copies, scratch) ───────────────────
docs/
Docs/
images/
report/VIDEO.mp4
report/CAD.zip
